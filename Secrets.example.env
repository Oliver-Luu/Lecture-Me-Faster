# Development API keys for Lecture Me Faster.
#
# Copy this file to "Lecture Me Faster/Secrets.env" (next to MyApp.swift) and fill in your keys.
# Secrets.env is git-ignored and is only bundled into Debug builds, never Release builds.
# A key typed into the app's Settings always takes priority over the one here.

ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
